{
  "name": "ink-arena-remastered",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "description": "Ink Arena Remastered desktop game",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "peerjs": "^1.5.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.inkarena.remastered",
    "productName": "Ink Arena Remastered",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "InkArenaRemastered-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ink Arena Remastered",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "soulux692",
        "repo": "ink-arena"
      }
    ]
  }
}
